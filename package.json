{
  "name": "art-of-stone",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive multi-page Art Of Stone website built with modern HTML, CSS, JavaScript and Webpack.",
  "scripts": {
    "start": "webpack serve --config webpack.dev.js --open",
    "dev": "webpack serve --config webpack.dev.js --open",
    "build": "webpack --config webpack.prod.js",
    "preview": "npx serve dist",
    "live": "concurrently \"webpack --config webpack.dev.js --watch\" \"live-server dist --port=8081 --watch=dist\""
  },
  "devDependencies": {
    "css-loader": "^7.1.2",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1",
    "live-server": "^1.2.2",
    "concurrently": "^9.1.2"
  },
  "type": "module"
}
